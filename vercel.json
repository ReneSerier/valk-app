{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": ".",
  "framework": "express",
   "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/index.js"
    }
  ]
}
